{
  "manifest_version": 3,
  "name": "Linet",
  "version": "0.1.1",
  "description": "Открыть текущую страницу или ссылку на телефоне (Linet Handoff).",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Открыть на телефоне"
  },
  "commands": {
    "send-tab": {
      "suggested_key": {
        "default": "Ctrl+Alt+P"
      },
      "description": "Открыть текущую вкладку на телефоне"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "linet@linet.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "key": ""
}
