[Unit]
Description=Linet — связь с Android-телефоном
After=graphical-session.target
PartOf=graphical-session.target ryoku-session.target

[Service]
Type=dbus
BusName=org.linet.Daemon
ExecStart=@LINETD@
Environment=PATH=@BINDIR@:/usr/local/sbin:/usr/local/bin:/usr/bin
ExecStartPre=/usr/bin/test -n ${WAYLAND_DISPLAY}
ExecStartPre=/usr/bin/test -S %t/${WAYLAND_DISPLAY}
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillMode=control-group

[Install]
WantedBy=@SESSION_TARGET@
